# /etc/cosyne/cosyne.env  (chmod 600, owned by root)
HOST=127.0.0.1
PORT=3100
# Public address the apps are served from (used in sticker QR codes).
PUBLIC_URL=https://iobeacons.com/cosyne
# Access codes for the public demo. Change all three before sharing the link.
ADMIN_TOKEN=change-me-admin
DISPATCH_TOKEN=change-me-dispatch
OFFICER_ENROLL_CODE=change-me-officer
# TURN relay (coturn, use-auth-secret) so video connects across NAT/cellular.
TURN_URLS=turn:iobeacons.com:3478?transport=udp,turn:iobeacons.com:3478?transport=tcp
TURN_SECRET=replace-with-output-of-openssl-rand-hex-32
# Pilot data (Tulsa PD sample drivers/officers). Set to off for a clean install.
COSYNE_DEMO=on
