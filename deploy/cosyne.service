[Unit]
Description=CO-SYNE network server (Tulsa PD pilot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cosyne
WorkingDirectory=/opt/cosyne
EnvironmentFile=/etc/cosyne/cosyne.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/cosyne/data

[Install]
WantedBy=multi-user.target
