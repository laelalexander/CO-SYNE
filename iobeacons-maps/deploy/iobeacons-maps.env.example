# /etc/iobeacons-maps/iobeacons-maps.env  (root:iobmaps, mode 640)
PORT=3120
HOST=127.0.0.1
BASE_PATH=/maps
PUBLIC_URL=https://iobeacons.com/maps
DATABASE_URL=postgres://iobmaps:CHANGE_ME@127.0.0.1:5432/iobmaps
COOKIE_SECURE=1
PG_POOL_MAX=6

# Open demo (no sign-in, resets daily)
DEMO_ENABLED=1
DEMO_RESET_HOURS=24

# IoBeacons staff who can see every workspace and change plans (comma separated)
STAFF_EMAILS=

# Optional services. Leave blank until you have the keys; the app says "not set up yet".
SMTP_URL=
MAIL_FROM=IoBeacons Maps <alerts@iobeacons.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
# Commercial basemaps and geocoding (recommended before charging customers)
MAPTILER_KEY=
