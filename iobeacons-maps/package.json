{
  "name": "iobeacons-maps",
  "version": "0.1.0",
  "private": true,
  "description": "IoBeacons Maps: self-serve GIS workspace (maps, data catalog, sites, alerts, reports, billing, API)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/server.js",
    "dev": "node scripts/build.mjs && node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node scripts/build.mjs && node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.3",
    "@xmldom/xmldom": "^0.9.12",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "express": "^4.22.3",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@turf/turf": "^7.4.0",
    "esbuild": "^0.28.2",
    "maplibre-gl": "^6.16.0",
    "terra-draw": "^1.39.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0"
  }
}
